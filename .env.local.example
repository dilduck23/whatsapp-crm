# =============================================
# SUPABASE
# =============================================
# Encuentra estos valores en: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# =============================================
# META / WHATSAPP CLOUD API
# =============================================
# Encuentra estos valores en: Meta for Developers > Tu App > WhatsApp > API Setup
WHATSAPP_TOKEN=tu-token-permanente-aqui
WHATSAPP_PHONE_NUMBER_ID=tu-phone-number-id-aqui

# Token de verificación del Webhook (invéntalo tú, ej: "mi_token_secreto_123")
WHATSAPP_VERIFY_TOKEN=tu-token-de-verificacion-aqui

# =============================================
# CONFIGURACIÓN ADICIONAL (OPCIONAL)
# =============================================
# ID de la cuenta de WhatsApp Business (para algunas operaciones avanzadas)
# WHATSAPP_BUSINESS_ACCOUNT_ID=tu-waba-id

# Versión de la API de Graph (por defecto v18.0)
# GRAPH_API_VERSION=v18.0
